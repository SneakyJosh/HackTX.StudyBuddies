# Placeholder names only. Copy this file to `.env.local` and fill values on your machine.
# Never commit real keys, database passwords, or service-role credentials.

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key. Safe to expose to the browser.
# This is not the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC, never send it to the browser,
# and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only xAI key for Grok compatibility. Never prefix with NEXT_PUBLIC.
XAI_API_KEY=
